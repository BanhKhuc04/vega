# Vite reads variables with the VITE_ prefix (put overrides in dashboard/.env.local).
# Data source: mock (default, "SIM") | mqtt
VITE_DATA_SOURCE=mock
# MQTT-over-WebSocket broker. Default: ws://<host serving the page>:9001
VITE_MQTT_URL=ws://localhost:9001
# Room whose readings drive the Idle screen
VITE_ROOM=bedroom
# Tools (npm run sim / scene / broker): broker URL and optional credentials
MQTT_URL=mqtt://localhost:1883
# MQTT_USER=brain
# MQTT_PASS=
# Brain (npm run brain): same MQTT_URL. Room meant by "phòng mấy độ", SQLite file, AI providers and limits:
# see infra/pi/brain.env.example for every LLM_* setting. LLM_ROUTER=mock answers offline with fixed rules.
VEGA_ROOM=bedroom
BRAIN_DB=brain.db
# CI watching (M3): read-only fine-grained token + repos to watch
# GITHUB_TOKEN=
# GITHUB_REPOS=owner/repo
# Personal assistant (M4): Google OAuth client ("Desktop app"), then run npm run google-login. README, section M4.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# WEATHER_LAT=
# WEATHER_LON=
# BRIEFING_AT=07:00
# VEGA_LANG=vi
# Research with sources (M6): free key from tavily.com. Optional limits.
# TAVILY_API_KEY=
# RESEARCH_MAX_USD=0.01
# SEARCH_MAX_MONTH=900
LLM_ROUTER=none
BUDGET_USD_DAY=0.20
