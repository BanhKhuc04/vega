# Copy to infra/pi/.env (setup.sh does this for you and fills in random passwords). Never commit .env.
# Passwords of the three MQTT users. `ui` is readable by anyone who can open the dashboard on the LAN
# (it ends up in /config.js), so it can only read vega/# and publish vega/system/command.
MQTT_BRAIN_PASS=change-me
MQTT_UI_PASS=change-me
MQTT_DEVICE_PASS=change-me
# This Pi's Tailscale address (`tailscale ip -4`; setup.sh fills it in). The dashboard (UI_PORT) and the MQTT
# WebSocket (MQTT_WS_PORT) listen only on localhost and this address, never on the LAN. Empty: localhost only.
TAILSCALE_IP=
# Ports. MQTT_PORT (ESP devices) is on the LAN; the other two follow TAILSCALE_IP above.
MQTT_PORT=1883
MQTT_WS_PORT=9001
UI_PORT=8080
# Room whose readings drive the Idle screen
VEGA_ROOM=bedroom
