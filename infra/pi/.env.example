# Copy to infra/pi/.env (setup.sh does this for you and fills in random passwords). Never commit .env.
# Passwords of the three MQTT users. `ui` is readable by anyone who can open the dashboard on the LAN
# (it ends up in /config.js), so it can only read vega/# and publish vega/system/command.
MQTT_BRAIN_PASS=change-me
MQTT_UI_PASS=change-me
MQTT_DEVICE_PASS=change-me
# M8: health.sh and backup.sh report on vega/system/health and vega/system/backup; the phone (OwnTracks) sends its location
MQTT_HEALTH_PASS=change-me
MQTT_PHONE_PASS=change-me
# M10: the Pi 3 watchdog (infra/pi3) reads vega/system/health and beats on vega/system/watch. Copy it to the Pi 3 when asked.
MQTT_WATCH_PASS=change-me
# Token of the Console API (/console). Like the `ui` password it ends up in /config.js: Tailscale and localhost only.
CONSOLE_TOKEN=change-me
# Backups (M8, backup.sh): public age key (setup.sh creates it and prints the private half once), folder (an SSD is best),
# and an rclone remote for a copy off the Pi, e.g. gdrive:vega-backups (empty: the backups stay on the Pi only).
AGE_RECIPIENT=
BACKUP_DIR=/var/backups/vega
RCLONE_REMOTE=
# This Pi's Tailscale address (`tailscale ip -4`; setup.sh fills it in). The dashboard (UI_PORT) and the MQTT
# WebSocket (MQTT_WS_PORT) listen only on localhost and this address, never on the LAN. Empty: localhost only.
TAILSCALE_IP=
# Ports. MQTT_PORT (ESP devices) is on the LAN; the other two follow TAILSCALE_IP above.
MQTT_PORT=1883
MQTT_WS_PORT=9001
UI_PORT=8080
# Room whose readings drive the Idle screen
VEGA_ROOM=bedroom
