# Users are created by infra/pi/setup.sh (mosquitto_passwd). Topic structure: docs/contract.md.

# the brain (M1) and the simulator/CLI tools may do everything under vega/
user brain
topic readwrite vega/#
# the phone's location (M8)
topic read owntracks/#
# the broker's own uptime: what the mosquitto healthcheck in docker-compose.yml subscribes to (without it: always unhealthy)
topic read $SYS/broker/uptime

# the dashboard: read everything, and send commands. Nothing else.
user ui
topic read vega/#
topic write vega/system/command

# ESP devices: report their own topics and receive commands. (Per-device users and ACLs arrive with M2.)
user device
topic write vega/+/+/state
topic write vega/+/+/meta
topic write vega/+/+/availability
topic read vega/+/+/set

# infra/pi/health.sh and backup.sh (M8): their two reports, nothing else
user health
topic write vega/system/health
topic write vega/system/backup

# the owner's phone, OwnTracks over Tailscale (M8): its own location, and commands the app may receive
user phone
topic write owntracks/vega/+
topic read owntracks/vega/+/cmd

# the Pi 3 watchdog (M10, brief 0014 P5): reads the Pi 4's health report, writes its own heartbeat, nothing else
user watch
topic read vega/system/health
topic write vega/system/watch
