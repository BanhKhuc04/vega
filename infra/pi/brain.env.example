# vega-brain settings on the Pi. setup.sh copies this to brain.env (mode 600). Never commit brain.env.
# Without any provider the brain still runs: local device commands work, other questions get "no AI configured".

# --- AI providers (OpenAI-compatible). One block per provider: LLM_<NAME>_* ---
# Known names need no BASE_URL: openai, deepseek, groq, openrouter, gemini, mistral.
# MODEL and both PRICE_* (USD per 1M tokens, from the provider's price page) are required: without prices the
# daily budget cannot be enforced, so the provider is ignored.
# LLM_DEEPSEEK_API_KEY=
# LLM_DEEPSEEK_MODEL=
# LLM_DEEPSEEK_PRICE_IN=
# LLM_DEEPSEEK_PRICE_OUT=
#
# Any other OpenAI-compatible endpoint (https only, or http on localhost or a Tailscale 100.x address):
# LLM_MYHOST_BASE_URL=https://example.com/v1
# LLM_MYHOST_API_KEY=
# LLM_MYHOST_MODEL=
# LLM_MYHOST_PRICE_IN=
# LLM_MYHOST_PRICE_OUT=
# Optional, per provider:
# LLM_MYHOST_API=responses              # endpoint speaks the OpenAI Responses API (/responses) instead of /chat/completions
# LLM_MYHOST_MAX_OUTPUT_TOKENS=512      # cap per call, reasoning included (default 512)

# --- Which provider does which job: router picks tools, chat writes the answer after tools ran ---
# none = local commands only. `npm run bench` (on a PC) helps choose.
LLM_ROUTER=none
# LLM_CHAT=        # defaults to LLM_ROUTER

# --- AI on the PC (M15, brief 0019): Ollama. While the PC is on it writes the answers; when the budget is spent, the
# internet is down or no cloud provider is set, it does all the AI work. PC off = as before. Price 0: your own machine.
# Ollama must listen on the PC's Tailscale address (OLLAMA_HOST=100.x.y.z:11434 on the PC, never 0.0.0.0): docs/security.md
# LLM_LOCAL=ollama
# LLM_OLLAMA_BASE_URL=http://100.x.y.z:11434/v1
# LLM_OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
# LLM_OLLAMA_PRICE_IN=0
# LLM_OLLAMA_PRICE_OUT=0

# --- GitHub Actions watching (M3). Fine-grained token, READ ONLY: Actions (read) + Metadata (read), selected repos only ---
# GITHUB_TOKEN=
# GITHUB_REPOS=owner/repo,owner/repo2
# GITHUB_POLL_S=60

# --- Personal assistant (M4): Google Calendar + Gmail, READ ONLY. Sign in on a PC (npm run google-login), then copy
# the "refresh_token" from google-token.json here (README, section M4) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_CALENDARS=primary
# WEATHER_LAT=
# WEATHER_LON=
# BRIEFING_AT=07:00
# VEGA_LANG=vi

# --- Research with sources (M6): web search by Tavily (free 1,000 credits a month, no card) ---
# TAVILY_API_KEY=
# LLM_RESEARCH=                # defaults to LLM_CHAT
# RESEARCH_MAX_USD=0.01        # cap of one research, all its AI calls together
# RESEARCH_MAX_OUTPUT_TOKENS=800
# SEARCH_MAX_MONTH=900         # web searches a month, never exceeded

# --- Vision (M7): "trên bàn có gì?" takes one photo and sends it to this provider (it must accept images) ---
# LLM_VISION=                  # no default: without it the camera is never used
# VISION_MAX_DAY=50            # photos looked at per day, never exceeded (each also counts in BUDGET_USD_DAY)
# Camera size, live video and YOLO rate (M7.1) belong to vega-vision: CAMERA_SIZE, LIVE_FPS, DETECT_HZ, LIVE_MAX_MIN in infra/pi/.env

# --- Voice input (M5): speech to text through the brain. Audio is sent to the provider only while the mic is held ---
# Groq (console.groq.com, free tier): only the key and the price are needed.
# STT_API_KEY=
# STT_USD_PER_HOUR=0.04       # USD per hour of audio, from the provider's price page (required: the daily budget counts it)
# STT_PROVIDER=groq           # or openai (STT_MODEL=whisper-1, STT_USD_PER_HOUR=0.36), or STT_BASE_URL for another endpoint
# STT_MODEL=whisper-large-v3-turbo
# STT_MAX_MIN_DAY=30          # minutes of audio a day, never exceeded
# STT_LANGUAGE=vi             # language spoken; empty = let Whisper guess (better for English commands, worse for short Vietnamese ones)
# STT_PROMPT=                 # words to spell right (rooms, devices); default: VEGA's own command words. Empty = no hint

# --- Phone alerts (M10): ntfy on the Pi 3. infra/pi3/setup.sh prints the three lines to paste here ---
# NTFY_URL=https://vega-watch.<tailnet>.ts.net
# NTFY_TOKEN=tk_...
# NTFY_TOPIC=vega-...

# --- Memory (M9): the AI may offer to remember a preference you stated; you always confirm. 0 = never offers ---
# MEMORY_SUGGEST=1

# --- Limits ---
BUDGET_USD_DAY=0.20
RATE_LIMIT_PER_MIN=10
CONFIRM_TTL_S=30
LLM_TIMEOUT_MS=20000
