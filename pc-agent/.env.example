# pc-agent settings (copy to pc-agent/.env; never commit .env). No API key here: speech to text goes through the brain.

# The brain and the broker on the Pi, through Tailscale (`tailscale serve` on the Pi). <tailnet>: the Pi's name in the
# Tailscale admin page, e.g. vega.tailxxxx.ts.net. MQTT_PASS = MQTT_AGENT_PASS from ~/vega/infra/pi/.env on the Pi.
MQTT_URL=wss://vega.<tailnet>.ts.net/mqtt
MQTT_USER=agent
MQTT_PASS=
VEGA_STT_URL=https://vega.<tailnet>.ts.net/voice/stt
# vega-voice (Piper); empty = show answers, do not read them aloud
VEGA_TTS_URL=https://vega.<tailnet>.ts.net/voice/tts
#
# Or VEGA on this PC (`npm run vega`): comment out the five lines above, the defaults are
# MQTT_URL=mqtt://127.0.0.1:1883  VEGA_STT_URL=http://127.0.0.1:8091/voice/stt  VEGA_TTS_URL=http://127.0.0.1:5002/voice/tts

# Wake word: your own file (README: train "Hey Vegas"), or a built-in model name to try the agent before that
WAKE_MODEL=models/hey_vegas.onnx
# WAKE_MODEL=hey_jarvis
# 0..1, higher = fewer false wakes but harder to wake
WAKE_THRESHOLD=0.5
# seconds after an answer when the next sentence needs no wake word
FOLLOW_UP_S=6
# closes / reopens the microphone
HOTKEY=ctrl+alt+m
