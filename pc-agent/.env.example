# pc-agent settings (copy to pc-agent/.env; never commit .env). No API key here: speech to text goes through the brain.

# The brain and the broker. On this PC with `npm run vega` the defaults are right.
# MQTT_URL=mqtt://127.0.0.1:1883
# VEGA_STT_URL=http://127.0.0.1:8091/voice/stt
# VEGA_TTS_URL=http://127.0.0.1:5002/voice/tts       # vega-voice (Piper); empty = show answers, do not read them aloud
#
# Later, against the Pi through Tailscale (M5.3: its own MQTT user `agent`):
# MQTT_URL=wss://vega.<tailnet>.ts.net/mqtt
# MQTT_USER=agent
# MQTT_PASS=
# VEGA_STT_URL=https://vega.<tailnet>.ts.net/voice/stt
# VEGA_TTS_URL=https://vega.<tailnet>.ts.net/voice/tts

# Wake word: a built-in model name, or your own file (README: train "Hey Vega")
WAKE_MODEL=hey_jarvis
# WAKE_MODEL=models/hey_vega.onnx
# 0..1, higher = fewer false wakes but harder to wake
WAKE_THRESHOLD=0.5
# seconds after an answer when the next sentence needs no wake word
FOLLOW_UP_S=6
# closes / reopens the microphone
HOTKEY=ctrl+alt+m
